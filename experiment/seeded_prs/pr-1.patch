diff --git a/tests/test_queries.py b/tests/test_queries.py
index e939eb4..b3cf9c2 100644
--- a/tests/test_queries.py
+++ b/tests/test_queries.py
@@ -527,3 +527,19 @@ def test_get_item():
 
     assert query({'test': 1})
     assert not query({'test': 0})
+
+
+@pytest.mark.parametrize('make_items', [
+    lambda: (v for v in ['a', 'b']),
+    lambda: iter(['a', 'b']),
+    lambda: map(str, ['a', 'b']),
+])
+def test_one_of_with_one_shot_iterables(make_items):
+    query = Query().key.one_of(make_items())
+
+    # The query must give the same answer for every document and on every
+    # evaluation, not just for the first one it sees.
+    assert query({'key': 'a'})
+    assert query({'key': 'b'})
+    assert query({'key': 'a'})
+    assert not query({'key': 'c'})
