+    def upsert_multiple(
+        self,
+        upserts: Iterable[tuple[Mapping, Optional[QueryLike]]],
+    ) -> list[int]:
+        """
+        Upsert many ``(document, cond)`` pairs.
+
+        :param upserts: an iterable of ``(document, cond)`` pairs
+        :returns: the IDs of all updated or inserted documents
+        """
+        ids: list[int] = []
+        for document, cond in upserts:
+            ids.extend(self.upsert(document, cond))
+
+        return ids
