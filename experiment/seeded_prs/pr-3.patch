+
+
+def test_upsert_multiple(db):
+    table = db.table('upm')
+    table.insert({'name': 'a', 'n': 1})
+
+    ids = table.upsert_multiple([
+        ({'name': 'a', 'n': 2}, where('name') == 'a'),
+        ({'name': 'b', 'n': 3}, where('name') == 'b'),
+    ])
+
+    assert ids == [1, 2]
+    assert table.all() == [{'name': 'a', 'n': 2}, {'name': 'b', 'n': 3}]
